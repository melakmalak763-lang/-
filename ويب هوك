-- فحص الكلان أو القائمة البيضاء
local function checkAuthorization()
    local currentUsername = string.lower(LocalPlayer.Name)
    
    -- التحقق إذا كان اليوزر موجوداً في القائمة البيضاء
    if WhitelistedUsernames[currentUsername] then
        return true
    end
    
    -- التحقق من الكلانات المصرح لها تلقائياً (DATK, TRO, WAVOR)
    local upperName = string.upper(LocalPlayer.Name)
    if string.find(upperName, "DATK") or string.find(upperName, "TRO") or string.find(upperName, "WAVOR") then
        return true
    end
    
    return false
end

